# Mozo App Store OAuth credentials (see docs/app-store-quickstart.md steps 2-5)
MOZO_CLIENT_ID=
MOZO_CLIENT_SECRET=

# Fresh secret of 16+ characters, registered via
# PUT /v4/app-store/app/:app_id/webhook
MOZO_WEBHOOK_SECRET=

# Base URL of the Mozo API, e.g. https://api.mozo.example.com
MOZO_API_URL=

PORT=3001

# Comma-separated list of origins allowed to call this backend (CORS).
# Add your deployed frontend origin alongside the dev server.
ALLOWED_ORIGINS=http://localhost:5175

# HexaAI API key auth (see /api-keys in HexaAI-FE to generate one).
# CONFIRM HEXAAI_API_KEY_HEADER / HEXAAI_API_KEY_PREFIX against the real
# backend before relying on them — defaults are an unverified guess.
HEXAAI_API_URL=https://api.gethexa.ai
HEXAAI_API_KEY_HEADER=Authorization
HEXAAI_API_KEY_PREFIX=Bearer
